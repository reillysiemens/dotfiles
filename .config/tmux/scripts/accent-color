#!/usr/bin/env bash
#
# Pick a Gruvbox dark accent color from a hash of the short hostname and
# apply it to the tmux options that depend on the accent.
#
# Exposes the chosen color as the @accent user option so status format
# strings (status-left, status-right, window-status-format, ...) can
# reference it via #{@accent}. Style options like pane-active-border-style
# do not format-expand user variables on render, so this script sets them
# to the literal colourN value directly.
#
# Invoked from ~/.tmux.conf via:
#     run-shell '~/.config/tmux/accent.sh'

set -euo pipefail

# Gruvbox dark accents as truecolor hex values. Only the bright variants for
# each hue, giving 7 distinct colors. Requires the terminal to support 24-bit
# color (declared via "Tc" in terminal-overrides in ~/.tmux.conf).
#
# The palette lives in ~/.config/tmux/config/theme.conf and is exposed as
# @red, @green, ... user options so this script (and others) can read it
# without duplicating the values.
readonly COLORS=(
    "$(tmux show-option -gqv @red)"
    "$(tmux show-option -gqv @green)"
    "$(tmux show-option -gqv @yellow)"
    "$(tmux show-option -gqv @blue)"
    "$(tmux show-option -gqv @purple)"
    "$(tmux show-option -gqv @aqua)"
    "$(tmux show-option -gqv @orange)"
)
readonly bg0="$(tmux show-option -gqv @bg0)"

host="$(hostname -s)"
hash="$(printf '%s' "$host" | cksum | awk '{print $1}')"
# accent="${COLORS[$((hash % ${#COLORS[@]}))]}"
accent="#3c3836"
# accent="#504945"
# accent="#a89984"

# Available to status format strings as #{@accent}.
tmux set-option -gq @accent "$accent"

# Style options need the literal value; format expansion does not apply.
tmux set-option        -g pane-active-border-style    "fg=${accent},bg=default"
tmux set-window-option -g window-status-bell-style    "fg=${bg0},bg=${accent}"

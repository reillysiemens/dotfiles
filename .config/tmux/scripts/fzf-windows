#!/usr/bin/env bash
#
# Fuzzy-pick a window in the current tmux session and switch to it.
#
# Each row mirrors window-status-format: a dark-on-rainbow cell for the
# window index and a light-on-bg0 cell for the window name. The rainbow
# palette comes from theme.conf via @red, @orange, ...; the per-window
# slot is (#I mod 7), matching @wc.

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/fzf-common"

current_window=$(tmux display-message -p '#I')

# Two-pass so columns align across rows: first collect entries and find
# max widths, then emit cells padded to those widths.
declare -a entries=()
max_idx=0
max_name=0
while IFS=$'\t' read -r idx name panes; do
    [[ $idx == "$current_window" ]] && continue
    entries+=("$idx"$'\t'"$name"$'\t'"$panes")
    (( ${#idx}  > max_idx  )) && max_idx=${#idx}
    (( ${#name} > max_name )) && max_name=${#name}
done < <(tmux list-windows -F $'#I\t#W\t#{window_panes}')

if (( ${#entries[@]} == 0 )); then
    tmux display-message 'no other windows'
    exit 0
fi

rows=""
for entry in "${entries[@]}"; do
    IFS=$'\t' read -r idx name panes <<< "$entry"
    slot="${WC_BY_MOD[$((idx % 7))]}"
    wc="${C[$slot]}"
    idx_padded=$(printf  "%${max_idx}d"   "$idx")
    name_padded=$(printf "%-${max_name}s" "$name")
    index_cell=$(cell "${C[bg0_h]}" "$wc"       " $idx_padded ")
    name_cell=$(cell  "${C[fg]}"    "${C[bg0]}" " $name_padded ")
    rows+="${idx}"$'\t'"${index_cell}${name_cell}  ${panes}p"$'\n'
done

selection=$(
    printf '%s' "$rows" \
        | fzf --no-tmux +m --reverse --exit-0 --no-preview --ansi \
              --delimiter=$'\t' --with-nth=2.. \
              --border rounded --padding 1 \
              "$FZF_COLOR" \
              --header 'Enter: switch window'
) || exit 0

target=${selection%%$'\t'*}
tmux select-window -t "$target"

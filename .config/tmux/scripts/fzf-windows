#!/usr/bin/env bash
#
# Fuzzy-pick a window in the current tmux session and switch to it.
#
# Each row mirrors window-status-format: a dark-on-rainbow cell for the
# window index and a light-on-bg0 cell for the window name. The rainbow
# palette comes from theme.conf via @red, @orange, ...; the per-window
# slot is (#I mod 7), matching @wc.

set -euo pipefail

source "${BASH_SOURCE[0]%/*}/fzf-common"

# Parallel arrays beat encoding tab-joined strings into a single array and
# re-splitting them per row. Two passes: collect + measure widths, then emit.
# One tmux fork instead of two: list-windows emits window_active so we can
# skip the active window inline rather than asking display-message for #I.
declare -a idxs=() names=() pane_counts=()
max_idx=0
max_name=0
while IFS=$'\t' read -r active idx name panes; do
    [[ $active == 1 ]] && continue
    idxs+=("$idx")
    names+=("$name")
    pane_counts+=("$panes")
    (( ${#idx}  > max_idx  )) && max_idx=${#idx}
    (( ${#name} > max_name )) && max_name=${#name}
done < <(tmux list-windows -F $'#{window_active}\t#I\t#W\t#{window_panes}')

if (( ${#idxs[@]} == 0 )); then
    tmux display-message 'no other windows'
    exit 0
fi

# All-builtin row build: printf -v and cell() avoid every $(...) fork.
rows=""
for i in "${!idxs[@]}"; do
    idx=${idxs[$i]}
    name=${names[$i]}
    panes=${pane_counts[$i]}
    slot=${WC_BY_MOD[$((idx % 7))]}
    printf -v idx_padded  "%${max_idx}d"   "$idx"
    printf -v name_padded "%-${max_name}s" "$name"
    cell index_cell bg0_h "$slot" " $idx_padded "
    cell name_cell  fg    bg0     " $name_padded "
    rows+="${idx}"$'\t'"${index_cell}${name_cell}  ${panes}p"$'\n'
done

selection=$(
    printf '%s' "$rows" \
        | "$FZF_BIN" --no-tmux +m --reverse --exit-0 --no-preview --ansi \
              --delimiter=$'\t' --with-nth=2.. \
              --border rounded --padding 1 \
              "$FZF_COLOR" \
              --header 'Enter: switch window'
) || exit 0

target=${selection%%$'\t'*}
tmux select-window -t "$target"

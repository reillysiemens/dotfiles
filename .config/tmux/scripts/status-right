#!/usr/bin/env bash
#
# Render the right-side tmux status bar in one invocation. Replaces
# the chain of three shell scripts (load, memory, battery) that the
# status format would otherwise fork once per second per metric.
#
# Each metric's percentage is colored on a green -> yellow -> orange ->
# red gradient. Load and memory go red as they climb; battery goes
# red as it falls, and its icon shifts from full to empty across the
# same thresholds.
#
# Separators borrow the accent color hardcoded in
# ~/.config/tmux/config/theme.conf, read from the @accent user option.
# Tmux re-parses the script's output for #[...] style sequences, so this
# script emits the fully-styled status string and theme.conf just calls it.
#
# Invoked from theme.conf as:
#     set -g status-right "#(~/.config/tmux/scripts/status-right)"

set -euo pipefail

# Gruvbox bright accents used for threshold coloring. Keep in sync
# with the palette in theme.conf.
readonly GREEN='#b8bb26'
readonly YELLOW='#fabd2f'
readonly ORANGE='#fe8019'
readonly RED='#fb4934'
readonly FG='#ebdbb2'

readonly LOAD_ICON='󱤓'    # nf-md-integrated_circuit_chip
readonly MEMORY_ICON='󰍛'  # nf-md-memory

# Battery glyphs covering full, two-thirds, one-third, and empty/outline
# states. Selected per-render to mirror the threshold bucket the
# percentage falls into, so the icon and color always agree.
readonly BATTERY_FULL_ICON='󱊣'        # nf-md-battery_high
readonly BATTERY_TWO_THIRDS_ICON='󱊢'  # nf-md-battery_medium
readonly BATTERY_ONE_THIRD_ICON='󱊡'   # nf-md-battery_low
readonly BATTERY_EMPTY_ICON='󰂎'       # nf-md-battery_outline

# Thresholds for metrics that worsen as they climb (load, memory).
# pct in [0,t1) green, [t1,t2) yellow, [t2,t3) orange, [t3,inf) red.
# Thresholds must be ascending.
worse_above() {
    local pct=$1 t1=$2 t2=$3 t3=$4
    if   (( pct < t1 )); then printf '%s' "$GREEN"
    elif (( pct < t2 )); then printf '%s' "$YELLOW"
    elif (( pct < t3 )); then printf '%s' "$ORANGE"
    else                      printf '%s' "$RED"
    fi
}

load_percentage() {
    awk -v n="$(nproc)" '{printf "%.0f", $1 / n * 100}' /proc/loadavg
}

memory_percentage() {
    awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2} END {printf "%.0f", (t-a)/t*100}' /proc/meminfo
}

# Empty when no battery is present or upower is unreachable; tolerated
# silently so a transient DBus hiccup doesn't blank the rest of the
# status line.
battery_percentage() {
    upower -b 2>/dev/null | awk '/percentage/ {gsub(/%/, "", $2); print $2; exit}' || true
}

accent="$(tmux show-option -gqv @accent 2>/dev/null || true)"
: "${accent:=$FG}"

load="$(load_percentage)"
memory="$(memory_percentage)"
battery="$(battery_percentage)"

load_color="$(worse_above "$load" 50 75 100)"
memory_color="$(worse_above "$memory" 60 75 90)"

# Battery is the one metric where the icon also tracks the threshold
# bucket, so color and glyph are picked together from a single cascade
# to keep the thresholds in one place.
if [[ -n "$battery" ]]; then
    if   (( battery < 15 )); then
        battery_color="$RED";    battery_icon="$BATTERY_EMPTY_ICON"
    elif (( battery < 30 )); then
        battery_color="$ORANGE"; battery_icon="$BATTERY_ONE_THIRD_ICON"
    elif (( battery < 50 )); then
        battery_color="$YELLOW"; battery_icon="$BATTERY_TWO_THIRDS_ICON"
    else
        battery_color="$GREEN";  battery_icon="$BATTERY_FULL_ICON"
    fi
    battery_text="${battery}%"
else
    battery_color="$FG"
    battery_icon="$BATTERY_EMPTY_ICON"
    battery_text=""
fi

sep="#[fg=${accent},bold]|"
fg="#[fg=${FG},nobold]"

load_seg="${fg} ${LOAD_ICON} #[fg=${load_color}]${load}%${fg} "
memory_seg="${fg} ${MEMORY_ICON} #[fg=${memory_color}]${memory}%${fg} "
battery_seg="${fg} ${battery_icon} #[fg=${battery_color}]${battery_text}${fg} "

printf '%s\n' "#[fg=${accent},bold][${load_seg}${sep}${memory_seg}${sep}${battery_seg}#[fg=${accent},bold]]#[fg=${FG}]"

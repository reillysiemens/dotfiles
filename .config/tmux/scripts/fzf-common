# Shared helpers for the fzf-* tmux scripts. Source this; do not execute it.
#
# After sourcing:
#   * FZF_BIN is the absolute path to the fzf binary, resolved once and
#     cached in the @fzf_bin tmux option. We invoke fzf via $FZF_BIN to
#     skip mise's shim, which adds ~70ms per call.
#   * Associative array C holds the Gruvbox palette from theme.conf, read via
#     the @bg0_h, @red, ... user options.
#   * Associative array C_RGB holds the same colors as pre-converted "R;G;B"
#     triples so the row-render loop never has to do hex math.
#   * Array WC_BY_MOD maps (#I mod 7) -> palette key, mirroring @wc.
#   * cell <out-var> <fg-key> <bg-key> <text> wraps text in a truecolor SGR
#     sequence and assigns it to out-var. fg-key and bg-key index into C_RGB.
#   * FZF_COLOR is a `--color=...` arg that themes fzf to match the palette.
#
# Optimized for speed: the popup runs on every prefix-w / prefix-Space and the
# user feels every fork. Everything below avoids subshells in hot paths.

# Resolve fzf once and cache the absolute path in a tmux global option. The
# mise shim is a ~70ms tax on every call; reading a tmux option is ~free.
# If the cached path ever goes stale (e.g. after a mise upgrade) the -x test
# triggers re-resolution on the next popup, so the cache self-heals.
FZF_BIN=$(tmux show-option -gqv @fzf_bin)
if [[ -z $FZF_BIN || ! -x $FZF_BIN ]]; then
    # Try, in order:
    #   1. mise on PATH (rare in popup contexts, free if it happens)
    #   2. mise via the shim symlink (the shim IS mise, so this always works
    #      as long as any shim has been generated)
    #   3. whatever PATH finds (covers non-mise installs)
    FZF_BIN=""
    if command -v mise &>/dev/null; then
        FZF_BIN=$(mise which fzf 2>/dev/null)
    fi
    if [[ -z $FZF_BIN && -L $HOME/.local/share/mise/shims/fzf ]]; then
        _mise=$(readlink -f "$HOME/.local/share/mise/shims/fzf")
        FZF_BIN=$("$_mise" which fzf 2>/dev/null)
        unset _mise
    fi
    [[ -n $FZF_BIN ]] || FZF_BIN=$(command -v fzf)
    [[ -n $FZF_BIN ]] && tmux set-option -gq @fzf_bin "$FZF_BIN"
fi

declare -gA C C_RGB

# One tmux fork for the whole palette instead of one per key. Options that
# aren't ours fall through the case and are ignored.
while IFS=' ' read -r _key _value; do
    case $_key in
        @bg0_h|@bg0|@bg1|@bg2|@fg|@red|@orange|@yellow|@green|@blue|@aqua|@purple)
            _value=${_value#\"}
            _value=${_value%\"}
            C[${_key#@}]=$_value
            ;;
    esac
done < <(tmux show-options -g)
unset _key _value

# Pre-convert every palette hex into an "R;G;B" triple. The render loop just
# slots these straight into the SGR template -- no per-row hex math, no forks.
for _k in "${!C[@]}"; do
    _h=${C[$_k]#\#}
    printf -v "C_RGB[$_k]" '%d;%d;%d' \
        "0x${_h:0:2}" "0x${_h:2:2}" "0x${_h:4:2}"
done
unset _k _h

# (#I mod 7) -> palette key. ROYGBIV with violet wrapping to slot 0, matching
# the conditional chain in theme.conf's @wc.
WC_BY_MOD=(purple red orange yellow green blue aqua)

# Caller-supplied out-var avoids the $(...) fork that the old API forced.
cell() {
    printf -v "$1" '\033[38;2;%s;48;2;%sm%s\033[0m' \
        "${C_RGB[$2]}" "${C_RGB[$3]}" "$4"
}

# Gruvbox-flavored fzf theme keyed off the palette above. Built once at source
# time and passed by callers as a single argv element so the embedded colons
# and commas aren't word-split. The $(...) is fine -- runs once, not per row.
_fzf_colors=(
    "fg:${C[fg]}"           "bg:${C[bg0]}"
    "hl:${C[yellow]}"       "fg+:${C[fg]}"
    "bg+:${C[bg1]}"         "hl+:${C[yellow]}"
    "info:${C[blue]}"       "prompt:${C[orange]}"
    "pointer:${C[blue]}"    "marker:${C[aqua]}"
    "spinner:${C[yellow]}"  "header:${C[aqua]}"
    "border:${C[bg2]}"      "gutter:${C[bg1]}"
)
FZF_COLOR="--color=$(IFS=','; printf '%s' "${_fzf_colors[*]}")"
unset _fzf_colors

#!/usr/bin/env bash
#
# Fuzzy-pick a pane in the current tmux session and jump to it.
#
# Mirrors window-status-format for the window-index and window-name cells
# (so the pane's home window is recognizable at a glance), then shows the
# pane index, current command, and current path. Per-window rainbow slot
# is (#I mod 7), matching @wc.

set -euo pipefail

source "${BASH_SOURCE[0]%/*}/fzf-common"

# Parallel arrays beat encoding tab-joined strings into a single array and
# re-splitting them per row. Two passes: collect + measure widths, then emit.
# A pane is THE current pane iff it's active within an active window; one tmux
# call (with both flags) replaces the separate display-message lookup.
declare -a widxs=() pidxs=() wnames=() cmds=() paths=()
max_widx=0
max_pidx=0
max_name=0
max_cmd=0
while IFS=$'\t' read -r wactive pactive widx pidx wname cmd path; do
    [[ $wactive == 1 && $pactive == 1 ]] && continue
    widxs+=("$widx")
    pidxs+=("$pidx")
    wnames+=("$wname")
    cmds+=("$cmd")
    paths+=("$path")
    (( ${#widx}  > max_widx )) && max_widx=${#widx}
    (( ${#pidx}  > max_pidx )) && max_pidx=${#pidx}
    (( ${#wname} > max_name )) && max_name=${#wname}
    (( ${#cmd}   > max_cmd  )) && max_cmd=${#cmd}
done < <(tmux list-panes -s -F $'#{window_active}\t#{pane_active}\t#I\t#P\t#W\t#{pane_current_command}\t#{pane_current_path}')

if (( ${#widxs[@]} == 0 )); then
    tmux display-message 'no other panes'
    exit 0
fi

# All-builtin row build: printf -v and cell() avoid every $(...) fork.
rows=""
for i in "${!widxs[@]}"; do
    widx=${widxs[$i]}
    pidx=${pidxs[$i]}
    wname=${wnames[$i]}
    cmd=${cmds[$i]}
    path=${paths[$i]}
    slot=${WC_BY_MOD[$((widx % 7))]}
    printf -v widx_padded "%${max_widx}d"  "$widx"
    printf -v pidx_padded "%${max_pidx}d"  "$pidx"
    printf -v name_padded "%-${max_name}s" "$wname"
    printf -v cmd_padded  "%-${max_cmd}s"  "$cmd"
    cell index_cell bg0_h "$slot" " $widx_padded "
    cell name_cell  fg    bg0     " $name_padded "
    display_path="${path/#$HOME/~}"
    rows+="${widx}:${pidx}"$'\t'"${index_cell}${name_cell}  .${pidx_padded}  ${cmd_padded}  ${display_path}"$'\n'
done

selection=$(
    printf '%s' "$rows" \
        | "$FZF_BIN" --no-tmux +m --reverse --exit-0 --no-preview --ansi \
              --delimiter=$'\t' --with-nth=2.. \
              --border rounded --padding 1 \
              "$FZF_COLOR" \
              --header 'Enter: jump to pane'
) || exit 0

target=${selection%%$'\t'*}
window_idx=${target%:*}
pane_idx=${target#*:}

tmux select-window -t "$window_idx"
tmux select-pane   -t "${window_idx}.${pane_idx}"

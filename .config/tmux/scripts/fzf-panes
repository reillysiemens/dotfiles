#!/usr/bin/env bash
#
# Fuzzy-pick a pane in the current tmux session and jump to it.
#
# Mirrors window-status-format for the window-index and window-name cells
# (so the pane's home window is recognizable at a glance), then shows the
# pane index, current command, and current path. Per-window rainbow slot
# is (#I mod 7), matching @wc.

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/fzf-common"

current_pane=$(tmux display-message -p '#I:#P')

# Two-pass so columns align across rows: first collect entries and find
# max widths, then emit cells padded to those widths.
declare -a entries=()
max_widx=0
max_pidx=0
max_name=0
max_cmd=0
while IFS=$'\t' read -r widx pidx wname cmd path; do
    key="${widx}:${pidx}"
    [[ $key == "$current_pane" ]] && continue
    entries+=("$widx"$'\t'"$pidx"$'\t'"$wname"$'\t'"$cmd"$'\t'"$path")
    (( ${#widx}  > max_widx )) && max_widx=${#widx}
    (( ${#pidx}  > max_pidx )) && max_pidx=${#pidx}
    (( ${#wname} > max_name )) && max_name=${#wname}
    (( ${#cmd}   > max_cmd  )) && max_cmd=${#cmd}
done < <(tmux list-panes -s -F $'#I\t#P\t#W\t#{pane_current_command}\t#{pane_current_path}')

if (( ${#entries[@]} == 0 )); then
    tmux display-message 'no other panes'
    exit 0
fi

rows=""
for entry in "${entries[@]}"; do
    IFS=$'\t' read -r widx pidx wname cmd path <<< "$entry"
    slot="${WC_BY_MOD[$((widx % 7))]}"
    wc="${C[$slot]}"
    widx_padded=$(printf "%${max_widx}d"  "$widx")
    pidx_padded=$(printf "%${max_pidx}d"  "$pidx")
    name_padded=$(printf "%-${max_name}s" "$wname")
    cmd_padded=$(printf  "%-${max_cmd}s"  "$cmd")
    index_cell=$(cell "${C[bg0_h]}" "$wc"       " $widx_padded ")
    name_cell=$(cell  "${C[fg]}"    "${C[bg0]}" " $name_padded ")
    display_path="${path/#$HOME/~}"
    rows+="${widx}:${pidx}"$'\t'"${index_cell}${name_cell}  .${pidx_padded}  ${cmd_padded}  ${display_path}"$'\n'
done

selection=$(
    printf '%s' "$rows" \
        | fzf --no-tmux +m --reverse --exit-0 --no-preview --ansi \
              --delimiter=$'\t' --with-nth=2.. \
              --border rounded --padding 1 \
              "$FZF_COLOR" \
              --header 'Enter: jump to pane'
) || exit 0

target=${selection%%$'\t'*}
window_idx=${target%:*}
pane_idx=${target#*:}

tmux select-window -t "$window_idx"
tmux select-pane   -t "${window_idx}.${pane_idx}"

#!/usr/bin/env bash
#
# Fuzzy-pick a tmux session and switch to it. Ctrl-T creates a new
# session, Ctrl-R renames the highlighted session, Ctrl-X deletes it
# (after a yes/no confirm). All interaction stays inside the popup:
# the picker uses fzf with --expect to dispatch on key, and the
# new/rename/delete prompts are themselves fzf invocations (single
# dummy row + --print-query for free text input, two-row yes/no fzf
# for the confirm). After any mutation the script re-execs itself
# to restart the picker with a fresh list. The picker excludes the
# current session so the delete action can't take out the session
# hosting the popup.
#
# Session colors stay in sync via the session-created and
# session-renamed hooks in theme.conf -- nothing here touches
# session-color directly.

set -euo pipefail

source "${BASH_SOURCE[0]%/*}/fzf-common"

# Reverse map: palette hex -> palette key. session-color only ever picks
# from these seven hashed hues, so this is a closed set. Sessions whose
# @session_color is the @fg fallback miss the map and render on the fg
# slot -- beige cell, dark text. Still readable, still consistent.
declare -A SLOT_BY_HEX
for _k in red orange yellow green blue aqua purple; do
    SLOT_BY_HEX[${C[$_k]}]=$_k
done
unset _k

restart() { exec "${BASH_SOURCE[0]}"; }

# Text input via fzf. Args: prompt, initial query (optional), header
# (optional). Feeds fzf one empty row so the picker stays alive, hides
# match info to keep the UI clean, and prints the typed query on Enter.
# Returns empty if the user cancels with Esc.
prompt() {
    local p=$1 q=${2:-} h=${3:-}
    printf '\n' | "$FZF_BIN" --no-tmux --reverse --no-info \
        --print-query --prompt="$p" --query="$q" \
        --border rounded --padding 1 \
        --header "$h" \
        --bind 'enter:print-query+accept' \
        "$FZF_COLOR" 2>/dev/null | head -1
}

# Yes/no via fzf. Default highlighted row is "no" for safety. Returns
# 0 only if the user selects yes; cancel (Esc) treated as no.
confirm() {
    local p=$1 choice
    choice=$(printf 'no\nyes\n' | "$FZF_BIN" --no-tmux --reverse --no-info \
        --prompt="$p " \
        --border rounded --padding 1 \
        --header 'Arrow + Enter, or Esc to cancel' \
        "$FZF_COLOR" 2>/dev/null) || return 1
    [[ $choice == yes ]]
}

do_new() {
    local name
    name=$(prompt 'New session: ' '' 'Enter to create, Esc to cancel')
    if [[ -z $name ]]; then restart; fi
    tmux new-session -d -s "$name"
    tmux switch-client -t "$name"
}

do_rename() {
    local cur=$1 name
    name=$(prompt 'Rename to: ' "$cur" 'Enter to rename, Esc to cancel')
    if [[ -z $name || $name == "$cur" ]]; then restart; fi
    tmux rename-session -t "$cur" "$name"
    restart
}

do_delete() {
    local target=$1
    if confirm "delete session $target?"; then
        tmux kill-session -t "$target"
    fi
    restart
}

# Build the picker rows: every session except the current one, ordered
# most-recently-active first. The name cell uses the session's hashed
# color from @session_color (set by session-color via hooks).
current=$(tmux display-message -p '#S')
declare -a names=() winds=() attached_flags=() colors=()
max_name=0
max_winds=0
while IFS=$'\t' read -r _activity name win_count attached col; do
    [[ $name == "$current" ]] && continue
    names+=("$name")
    winds+=("$win_count")
    attached_flags+=("$attached")
    colors+=("$col")
    (( ${#name}      > max_name  )) && max_name=${#name}
    (( ${#win_count} > max_winds )) && max_winds=${#win_count}
done < <(
    tmux list-sessions -F $'#{session_activity}\t#{session_name}\t#{session_windows}\t#{session_attached}\t#{@session_color}' \
        | sort -t$'\t' -k1,1 -nr
)

# If there are no other sessions, jump straight to the new-session
# flow -- otherwise the picker would just be a blank popup.
if (( ${#names[@]} == 0 )); then
    do_new
    exit 0
fi

rows=""
for i in "${!names[@]}"; do
    name=${names[$i]}
    win_count=${winds[$i]}
    attached=${attached_flags[$i]}
    col=${colors[$i]}
    slot=${SLOT_BY_HEX[$col]:-fg}
    printf -v name_padded  "%-${max_name}s"  "$name"
    printf -v winds_padded "%${max_winds}d"  "$win_count"
    cell name_cell bg0_h "$slot" " $name_padded "
    row="${name_cell}  ${winds_padded}w"
    (( attached > 0 )) && row+="  attached"
    rows+="${name}"$'\t'"${row}"$'\n'
done

# --expect makes fzf print the pressed key on line 1 then the selected
# row(s) on the following lines. Enter exits with an empty key.
out=$(printf '%s' "$rows" \
    | "$FZF_BIN" --no-tmux +m --reverse --exit-0 --no-preview --ansi \
          --delimiter=$'\t' --with-nth=2.. \
          --border rounded --padding 1 \
          "$FZF_COLOR" \
          --header 'Enter: switch | Alt-A: new | Alt-E: rename | Alt-D: delete' \
          --expect=alt-a,alt-e,alt-d) || exit 0

key=$(printf '%s' "$out" | sed -n 1p)
line=$(printf '%s' "$out" | sed -n 2p)
target=${line%%$'\t'*}

case $key in
    alt-a) do_new ;;
    alt-e) if [[ -n $target ]]; then do_rename "$target"; else restart; fi ;;
    alt-d) if [[ -n $target ]]; then do_delete "$target"; else restart; fi ;;
    '')    if [[ -n $target ]]; then tmux switch-client -t "$target"; fi ;;
esac
